                <include>org.apache.logging.log4j:log4j-slf4j-impl:jar</include>
            </includes>
        </dependencySet>

        <!-- ============ Starter Jars ============  -->
        <dependencySet>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <unpack>false</unpack>
            <includes>
                <!-- Flink V2 starter -->
